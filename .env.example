OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: only needed if you enable image captioning in the reader agent.
ARK_API_KEY=

# --- Evaluation / failure-mining framework (eval/) ---
# Only needed if you set PAPER2CODE_TRACE_ENABLED=1. Standard boto3 vars —
# omit them entirely to use ~/.aws/credentials or an instance role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
PAPER2CODE_TRACE_BUCKET=paper2code-agent-trace
PAPER2CODE_TRACE_ENABLED=0
