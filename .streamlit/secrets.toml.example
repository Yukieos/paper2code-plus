# Copy to .streamlit/secrets.toml for local use, or paste into
# "Advanced settings > Secrets" when deploying on Streamlit Community Cloud.
# Streamlit exposes top-level keys here as environment variables too, so the
# app (and the main.py / codegen_pipeline.py subprocesses it launches) can
# read them the same way it reads a local .env file.

# Leave these two commented out on a PUBLIC deployment — otherwise every
# visitor's runs are billed to this key. Only set them for a private/trusted
# deployment where you're OK covering usage.
# OPENAI_API_KEY = "sk-..."
# PAPER2CODE_ALLOW_SHARED_KEY = "1"

# Safe to set on a public deployment: only used by the eval/trace-mining
# side (Stage 2+), not by an anonymous visitor's own pipeline run.
# AWS_ACCESS_KEY_ID = "..."
# AWS_SECRET_ACCESS_KEY = "..."
# AWS_DEFAULT_REGION = "us-east-1"
# PAPER2CODE_TRACE_BUCKET = "paper2code-agent-trace"
